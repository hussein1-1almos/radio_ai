API_KEY=12434325435435234532432342
# Local MedMO checkpoint
MODEL_PATH=/srv/models/MedMO-4B-Next
MODEL_VERSION=MedMO-4B-Next

# CPU-only inference
DEVICE=cpu
NUM_THREADS=8
TRUST_REMOTE_CODE=false

# Upload and image processing limits
MAX_UPLOAD_BYTES=33554432
MAX_PIXELS=64000000
MAX_IMAGE_EDGE=1536

# Generation and localization
MAX_NEW_TOKENS=512
LOCALIZATION_MAX_NEW_TOKENS=256
BOX_COORDINATE_SCALE=1000

# Annotation storage
ANNOTATED_DIR=./data/annotations
RETENTION_SECONDS=3600

# API security
INCLUDE_PHI=0

# Queue and runtime
MAX_QUEUE=4
INFERENCE_TIMEOUT=300
IDLE_UNLOAD_SECONDS=300
NICE=10
LOG_LEVEL=INFO
