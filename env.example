API_KEY=replace-with-a-long-random-secret
# --- resource limits (CPU only) ---
THREADS=4                 # CPU threads per inference; default = half the cores
NICE=10
MAX_LOADED_MODELS=2
MAX_QUEUE=4
INFERENCE_TIMEOUT=300     # seconds before 504
MAX_IMAGE_EDGE=1024
MAX_PIXELS=64000000
MAX_UPLOAD_BYTES=33554432
MAX_BOX_AREA=0.85         # boxes covering more of the image than this are rejected as generic
# --- privacy / retention ---
INCLUDE_PHI=0             # 1 = echo patient name/ID/birth date in responses
ANNOTATED_DIR=            # default: <tmp>/radai_annotated (mode 0700)
RETENTION_SECONDS=3600    # annotated images are deleted after this
# --- optional narrative text (rewrites the detector summary only; never sees pixels) ---
LLM=0                     # 0 | local (MedGemma GGUF, CPU) | api (OpenAI-compatible chat endpoint)
MODEL_PATH=models/medgemma-1.5-4b-it-Q8_0.gguf
N_CTX=2048
IDLE_UNLOAD_SECONDS=300
REPORT_API_KEY=
REPORT_API_MODEL=gpt-6-astra
REPORT_API_URL=https://api.openai.com/v1/chat/completions
REPORT_API_TIMEOUT=60
